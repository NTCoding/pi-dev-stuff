{
  "name": "pi-dev-stuff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run validate:profiles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "tsx platform/infra/cli/profile-launcher.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:profiles": "tsx platform/infra/validation/validate-profiles-command.ts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run test"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
